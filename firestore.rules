rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEducator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'edeni@standwithus.com'
            || request.auth.token.email == 'egarfunkel@standwithus.com'
            || request.auth.token.email == 'yehuda@standwithus.com');
    }
    function ownsRoom(roomId) {
      return isEducator()
        && exists(/databases/$(database)/documents/classrooms/$(roomId))
        && get(/databases/$(database)/documents/classrooms/$(roomId)).data.ownerEmail == request.auth.token.email;
    }
    function validAnswer(a) {
      return a is map
        && a.keys().hasAll(['text', 'image', 'caption'])
        && a.keys().hasOnly(['text', 'image', 'caption'])
        && a.text is string && a.text.size() <= 850
        && a.image is string && a.image.size() <= 125000
        && a.caption is string && a.caption.size() <= 180;
    }
    function validSubmission() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['team','theme','answers','authorUid','createdAt'])
        && request.resource.data.keys().hasAll(['team','theme','answers','authorUid','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.team is string
        && request.resource.data.team.size() > 0
        && request.resource.data.team.size() <= 65
        && request.resource.data.theme in ['land','community','early','water','breakthroughs','global']
        && request.resource.data.createdAt == request.time
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 5
        && validAnswer(request.resource.data.answers[0])
        && validAnswer(request.resource.data.answers[1])
        && validAnswer(request.resource.data.answers[2])
        && validAnswer(request.resource.data.answers[3])
        && validAnswer(request.resource.data.answers[4]);
    }
    function roomOpen(roomId) {
      return exists(/databases/$(database)/documents/classrooms/$(roomId))
        && get(/databases/$(database)/documents/classrooms/$(roomId)).data.closed == false;
    }
    match /classrooms/{roomId} {
      allow get, list: if isEducator() && resource.data.ownerEmail == request.auth.token.email;
      allow create: if isEducator()
        && roomId.matches('[A-Z2-9]{7}')
        && request.resource.data.keys().hasAll(['name','ownerEmail','closed','createdAt'])
        && request.resource.data.keys().hasOnly(['name','ownerEmail','closed','createdAt'])
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 65
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time;
      allow update: if ownsRoom(roomId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
        && request.resource.data.closed is bool;
      allow delete: if false;
      match /submissions/{submissionId} {
        allow get, list: if ownsRoom(roomId);
        allow create: if roomOpen(roomId) && validSubmission();
        allow update: if false;
        allow delete: if ownsRoom(roomId);
      }
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
